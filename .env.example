# ==============================================================================
# ARCHITECTURAL ENVIRONMENT CONFIGURATION BLUEPRINT
# Project: Tessera / AI Agent OS / Gemini Code Enhancer Engine
# Description: Canonical environment manifest declaring primary runtime secrets,
#              multi-provider LLM fallback credentials, Zero-Leak sandbox flags,
#              consensus weighting thresholds, and local memory persistence paths.
# Connections: Consumed by `src/lib/env-validator.ts` & `src/lib/consensus-config.ts`
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRIMARY RUNTIME & HOSTING IDENTIFIERS
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Primary AI provider key for Gemini API requests.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Canonical host origin URL for self-referential links, OAuth callbacks, and API endpoints.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# NODE_ENV: Application runtime mode (development, production, test)
NODE_ENV="development"

# PORT: Server listener port
PORT=3000

# ------------------------------------------------------------------------------
# 2. MULTI-PROVIDER LLM FALLBACK CREDENTIALS (SERVER-SIDE PROXY)
# ------------------------------------------------------------------------------
# Secondary fallback LLM keys routed via server-side module loader
ANTHROPIC_API_KEY=
CEREBRAS_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Local / On-Device LLM Inference Server (Termux / Colab / Ollama support)
OLLAMA_BASE_URL="http://localhost:11434"

# ------------------------------------------------------------------------------
# 3. CLIENT-SIDE KEYS (DEPRECATED - RETAINED FOR BACKWARD COMPATIBILITY)
# Note: Prefer server-side proxy routes above to prevent API key leaks.
# ------------------------------------------------------------------------------
VITE_ANTHROPIC_API_KEY=
VITE_CEREBRAS_API_KEY=
VITE_XAI_API_KEY=

# ------------------------------------------------------------------------------
# 4. KERNEL & CONSENSUS ENGINE WEIGHTING CONFIGURATION
# ------------------------------------------------------------------------------
# Minimum confidence threshold required to pass multi-agent consensus (0.0 to 1.0)
CONSENSUS_THRESHOLD=0.75

# Relative consensus weights per LLM provider engine
CONSENSUS_WEIGHT_GEMINI=0.95
CONSENSUS_WEIGHT_ANTHROPIC=0.90
CONSENSUS_WEIGHT_DEEPSEEK=0.85
CONSENSUS_WEIGHT_XAI=0.80
CONSENSUS_WEIGHT_CEREBRAS=0.75
CONSENSUS_WEIGHT_GROQ=0.70
CONSENSUS_WEIGHT_LOCAL=0.60

# ------------------------------------------------------------------------------
# 5. ZERO-LEAK SANDBOX & MEMORY PERSISTENCE CONTROLS
# ------------------------------------------------------------------------------
# Enable Zero-Leak WeakMap / FinalizationRegistry memory isolation in sandbox execution
ZERO_LEAK_SANDBOX_ENABLED=true

# Flat-file local memory persistence directory path
MEMORY_PERSISTENCE_PATH="./memory"

# Diagnostic check execution interval in milliseconds
DIAGNOSTIC_HEALTH_CHECK_INTERVAL=60000

# Logging severity filter: debug | info | warn | error
LOG_LEVEL="info"